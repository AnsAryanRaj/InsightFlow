# Copy to .env (or set these in your host's dashboard)
# IMPORTANT: Never commit .env with real secret keys to version control.

# ==============================================================================
# Adaption AI Enrichment Pipeline
# ==============================================================================
# Obtains structured analysis (sentiment, topic, severity, summary, action)
# and data quality evaluations directly from Adaption's Adaptive Data API.
#
# When unset: InsightFlow operates in safe Local Rules fallback mode (100% offline).
# When set: Enables cost estimation and full background enrichment via:
#   1. Insights page UI ("Get estimate" / "Run enrichment")
#   2. CLI runner: python -m scripts.run_adaption --estimate
# Expected runtime: ~2-5 minutes for 320 unique reviews.
# Output saved to: backend/data/adaption_results.json
ADAPTION_API_KEY=

# ==============================================================================
# Optional: Claude Fallback for Free-form Reviews
# ==============================================================================
# Used only for novel free-form reviews that topic rules cannot place ("other").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ==============================================================================
# Network & Database Configuration
# ==============================================================================
# Frontend address(es) allowed to call the API, comma separated. * allows all.
CORS_ORIGINS=*

# SQLite by default. For persistent data across host restarts use Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
DATABASE_URL=

# Load the Build Battle sample on first start when the database is empty (1 = yes)
AUTOLOAD_SAMPLE=1

