# Copy to .env (or set these in your host's dashboard)

# Adaption: turns on the enrichment pipeline (Insights page > Run enrichment)
ADAPTION_API_KEY=

# Optional: Claude reads new free-form feedback the topic rules cannot place
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Frontend address(es) allowed to call the API, comma separated. * allows all.
CORS_ORIGINS=*

# SQLite by default. For data that survives restarts use Postgres, for example Supabase:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
DATABASE_URL=

# Load the Build Battle sample on first start when the database is empty
AUTOLOAD_SAMPLE=1
